# if you want to deploy on a specific network and not expose your api key
# you just create a .env.local (or .env.<network>.local) with the following
# ETH_NODE_URI_<network>=<endpoint-url>
# MNEMONIC_<network>="<mnemonic>>"
# you can also add the etherscan api key for verification
# ETHERSCAN_API_KEY=<api-key>

ETH_NODE_URI_localhost="http://127.0.0.1:8545"
MNEMONIC_localhost="test test test test test test test test test test test junk"

ETH_NODE_URI_lan="http://ethereum.local:8545"
MNEMONIC_lan="test test test test test test test test test test test junk"

# ----------------------------------------------------------------------------
# Plain private key for the testnets where the race reproduces.
# Replace with a key that has OP Sepolia / Base Sepolia ETH before running
# `pnpm contracts:deploy --network optimism-sepolia --reset`.
#
# The placeholder below is the well-known hardhat dev key (account #0).
# It has no testnet ETH — the deploy will fail at gas estimation, not at the
# race. Override locally in .env.local (gitignored) with your own funded key.
# ----------------------------------------------------------------------------
DEPLOYER_PRIVATE_KEY="0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80"

# Alchemy URLs preset to scaffold-eth-2's shared fallback key.
# This key is publicly committed in scaffold-eth-2/packages/hardhat/hardhat.config.ts
# (rate-limited, fine for repro purposes). The race is most reliably triggered
# on Alchemy infra, so this is the recommended path for reviewers.
# Override locally in .env.local with your own Alchemy key for higher rate limits.
ETH_NODE_URI_OPTIMISM_SEPOLIA="https://opt-sepolia.g.alchemy.com/v2/cR4WnXePioePZ5fFrnSiR"
ETH_NODE_URI_BASE_SEPOLIA="https://base-sepolia.g.alchemy.com/v2/cR4WnXePioePZ5fFrnSiR"
